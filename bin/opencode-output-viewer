#!/usr/bin/env python3
"""Chromeless viewer for OpenCode output pages.

Replaces the browser launch: a plain GTK3 + WebKitGTK window with no toolbar
at all, its own WM_CLASS (so Cinnamon groups the output windows under their
own icon), and a persisted zoom level.
"""
import json
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, Gtk, WebKit2  # noqa: E402

CONFIG_DIR = os.path.join(os.path.expanduser("~"), ".config", "opencode-browser-output")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
DEFAULT_ZOOM = 1.0
MIN_ZOOM, MAX_ZOOM, STEP = 0.25, 4.0, 0.1

if len(sys.argv) < 2:
    print("usage: opencode-output-viewer file-or-url", file=sys.stderr)
    sys.exit(1)

def load_zoom():
    try:
        with open(CONFIG_FILE) as f:
            return max(MIN_ZOOM, min(MAX_ZOOM, float(json.load(f).get("zoom", DEFAULT_ZOOM))))
    except Exception:
        return DEFAULT_ZOOM

def save_zoom(level):
    data = {}
    try:
        with open(CONFIG_FILE) as f:
            data = json.load(f)
    except Exception:
        pass
    data["zoom"] = round(level, 3)
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(data, f, indent=2)
    except Exception:
        pass

target = sys.argv[1]
if not target.startswith(("file://", "http://", "https://")):
    target = "file://" + os.path.abspath(target)

settings = WebKit2.Settings()
settings.set_property("enable-smooth-scrolling", False)
view = WebKit2.WebView(settings=settings)
view.set_zoom_level(load_zoom())

window = Gtk.Window(title="OpenCode Output")
window.set_wmclass("opencode-output", "OpenCode Output")


def default_size():
    """Work area in logical pixels.

    GTK multiplies the default size by the HiDPI scale factor, so asking for
    1000x900 requests 2000x1800 physical, the WM then clamps it to the work
    area, and WebKit's rendering surface ends up shorter than the widget —
    which shows up as a strip of the window background at the bottom.
    """
    try:
        screen = Gdk.Screen.get_default()
        monitor = screen.get_monitor_at_window(screen.get_active_window() or screen.get_root_window())
        rect = screen.get_monitor_workarea(monitor)
        scale = screen.get_monitor_scale_factor(monitor)
        return rect.width // scale, rect.height // scale
    except Exception:
        return 960, 540


window.set_default_size(*default_size())
window.add(view)

def apply(level, persist=True):
    level = max(MIN_ZOOM, min(MAX_ZOOM, round(level, 3)))
    view.set_zoom_level(level)
    if persist:
        save_zoom(level)

def on_key(w, event):
    state = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK)
    if not state:
        return False
    key = Gdk.keyval_name(event.keyval)
    if key in ("plus", "equal", "KP_Add"):
        apply(view.get_zoom_level() + STEP)
        return True
    if key in ("minus", "KP_Subtract"):
        apply(view.get_zoom_level() - STEP)
        return True
    if key in ("0", "KP_0"):
        apply(1.0)
        return True
    return False

def on_scroll(w, event):
    if not (event.state & Gdk.ModifierType.CONTROL_MASK):
        return False
    if event.direction == Gdk.ScrollDirection.UP:
        apply(view.get_zoom_level() + STEP)
    elif event.direction == Gdk.ScrollDirection.DOWN:
        apply(view.get_zoom_level() - STEP)
    return True

def prefers_dark():
    try:
        settings = Gtk.Settings.get_default()
        if settings is None:
            return False
        theme = (settings.get_property("gtk-theme-name") or "").lower()
        if "dark" in theme:
            return True
        return bool(settings.get_property("gtk-application-prefer-dark-theme"))
    except Exception:
        return False

def debug_page(view, result, user_data=None):
    try:
        value = view.run_javascript_finish(result).get_js_value().to_string()
    except Exception as e:
        value = f"<no result: {e}>"
    a = view.get_allocation()
    print(f"[viewer] widget={a.width}x{a.height} window={window.get_size().width}x{window.get_size().height} zoom={view.get_zoom_level()} page={value}", flush=True)

def on_load_changed(view, event):
    if event != WebKit2.LoadEvent.FINISHED:
        return
    if os.environ.get("OC_VIEWER_DEBUG"):
        view.run_javascript(
            "JSON.stringify({dpr:devicePixelRatio,vw:document.documentElement.clientWidth,"
            "vh:document.documentElement.clientHeight,ih:innerHeight})",
            None,
            debug_page,
        )
    # WebKitGTK has no xdg-desktop-portal settings provider under Cinnamon, so
    # prefers-color-scheme would always evaluate light. Pin it to the GTK theme.
    scheme = "dark" if prefers_dark() else "light"
    view.run_javascript(
        "(function(){var m=document.createElement('meta');"
        "m.name='color-scheme';m.content='" + scheme + "';"
        "document.head.appendChild(m);"
        "var s=document.createElement('style');"
        "s.textContent='html{scroll-behavior:auto !important}';"
        "document.head.appendChild(s);})();"
    )

window.connect("key-press-event", on_key)
window.connect("scroll-event", on_scroll)
window.connect("destroy", Gtk.main_quit)

view.load_uri(target)

# Paint the theme background before the page CSS arrives, otherwise the fresh
# window flashes white (most visible at the bottom, where the page is shorter
# than the window).
view.set_background_color(Gdk.RGBA(0.102, 0.102, 0.102, 1.0) if prefers_dark() else Gdk.RGBA(1.0, 1.0, 1.0, 1.0))
view.connect("load-changed", on_load_changed)
window.show_all()
Gtk.main()
