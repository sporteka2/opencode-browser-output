#!/usr/bin/env bash
# Opens OpenCode output pages in a dedicated Firefox profile.
#
# * --class opencode-output gives the windows their own WM_CLASS, so Cinnamon
#   groups them under their own panel icon (see opencode-output.desktop)
#   instead of merging them into the main Firefox group
# * the profile's chrome/userChrome.css hides the URL and tab bars (URL bar
#   slides in on hover / Ctrl+L); user.js enables userChrome support
# * after the window appears we strip the window-manager titlebar, so the
#   minimise/maximise/close panel is gone too
#
# Falls back to the chromeless GTK viewer when the profile or Firefox is
# missing.
set -euo pipefail

PROFILE="${HOME}/.mozilla/firefox/ciefemfa.opencode-output"
[ -d "$PROFILE" ] || PROFILE=$(grep -A2 'Name=opencode-output' "${HOME}/.mozilla/firefox/profiles.ini" | awk -F= '/^Path=/{print $2; exit}')
case "$PROFILE" in
  /*) ;;
  *)  PROFILE="${HOME}/.mozilla/firefox/${PROFILE}" ;;
esac

FF=$(command -v firefox-dev || command -v firefox || true)
if [ -z "$FF" ] || [ ! -d "$PROFILE" ]; then
  exec "${HOME}/.local/bin/opencode-output-viewer" "$@"
fi

before=$(wmctrl -lx 2>/dev/null | awk '$3 ~ /Navigator\.opencode-output$/ {print $1}' | sort)
# GTK_CSD=0 makes Firefox stop drawing its own titlebar, so Muffin draws the
# real one (with the window buttons); without it Firefox keeps a "no
# decorations" hint and the window has no WM titlebar at all.
GTK_CSD=0 "$FF" --class opencode-output --profile "$PROFILE" --new-window "$@" >/dev/null 2>&1 &

# Wait for the new window, then clear _MOTIF_WM_HINTS so Muffin draws the
# titlebar with the minimise/maximise/close buttons again (Firefox leaves the
# "no decorations" hint behind, which silently removed them).
for _ in $(seq 1 60); do
  sleep 0.25
  now=$(wmctrl -lx 2>/dev/null | awk '$3 ~ /Navigator\.opencode-output$/ {print $1}' | sort)
  new=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$now") | head -1)
  [ -n "$new" ] || continue
  xprop -id "$new" -remove _MOTIF_WM_HINTS 2>/dev/null || true
  exit 0
done
exit 0
